{
  "name": "cwt",
  "version": "1.0.0",
  "description": "Can's WhatsApp Backup Tool - Export WhatsApp Web conversations with full media support",
  "author": "Can",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/canbagdiken/cwt.git"
  },
  "homepage": "https://github.com/canbagdiken/cwt#readme",
  "keywords": [
    "whatsapp",
    "export",
    "backup",
    "chat",
    "chrome-extension",
    "browser-extension"
  ],
  "scripts": {
    "bundle": "webpack --config webpack.config.js && cp node_modules/@wppconnect/wa-js/dist/wppconnect-wa.js extension/wppconnect-wa.js",
    "package": "node scripts/build.js",
    "build": "npm run bundle && npm run package",
    "clean": "rm -rf extension/UZIP.js extension/wppconnect-wa.js *.zip"
  },
  "dependencies": {
    "@wppconnect/wa-js": "^3.3.0",
    "archiver": "^7.0.1",
    "uzip": "^0.20201231.0"
  },
  "devDependencies": {
    "webpack": "^5.105.0",
    "webpack-cli": "^6.0.1"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
